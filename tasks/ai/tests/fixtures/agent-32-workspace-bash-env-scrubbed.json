{
  "description": "a bash command does not see the run's params, endpoint credentials or results channel",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "Bump the version and check it.",
    "workspaceTools": "bash",
    "workdir": "${WORKSPACE}/repo"
  },
  "env": {
    "OPENAI_API_KEY": "sk-env-key"
  },
  "workspace": {
    "repo/a.txt": "a"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1_0",
                  "type": "function",
                  "function": {
                    "name": "bash",
                    "arguments": "{\"command\": \"echo \\\"[${PARAM_TOKEN}][${OPENAI_API_KEY}][${PARAM_NAMES}][${RESULTS_PATH}]\\\"\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-9",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "done"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "requests": [
      {
        "index": 1,
        "bodyContains": [
          "[][][][]"
        ],
        "bodyNotContains": [
          "sk-test-do-not-log-me",
          "sk-env-key"
        ]
      }
    ]
  }
}
