{
  "description": "a tool result flagged isError goes back to the model as ERROR text and the loop continues",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "mcpServers": "[{\"name\": \"tools\", \"url\": \"${MCP:tools}\"}]"
  },
  "mcp": {
    "tools": {
      "tools": [
        {
          "name": "clock",
          "inputSchema": {
            "type": "object"
          },
          "result": {
            "text": "service down",
            "isError": true
          }
        }
      ]
    }
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "c",
                  "type": "function",
                  "function": {
                    "name": "clock",
                    "arguments": "{}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "could not tell the time"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "results": {
      "output": "could not tell the time",
      "toolCalls": "1"
    },
    "requests": [
      {
        "index": 1,
        "body": {
          "messages": [
            {
              "role": "user"
            },
            {
              "role": "assistant"
            },
            {
              "role": "tool",
              "content": "ERROR: service down"
            }
          ]
        }
      }
    ],
    "stdout": [
      "\"tool\":\"clock\"",
      "\"ok\":false"
    ]
  }
}
