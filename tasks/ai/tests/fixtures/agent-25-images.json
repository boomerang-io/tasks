{
  "description": "the agent sends images with the first user message and they stay in the history on every later turn; the JSON-lines trace is unchanged",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "mcpServers": "[{\"name\": \"tools\", \"url\": \"${MCP:tools}\"}]",
    "images": "${WORKSPACE}/shot.png"
  },
  "workspace": {
    "shot.png": {
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg=="
    }
  },
  "mcp": {
    "tools": {
      "tools": [
        {
          "name": "weather",
          "description": "Current weather for a city",
          "inputSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          },
          "result": "Sunny, 24C"
        },
        {
          "name": "clock",
          "description": "The current time",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "result": "12:00"
        }
      ]
    }
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "c",
                  "type": "function",
                  "function": {
                    "name": "clock",
                    "arguments": "{}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "noon"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "results": {
      "output": "noon",
      "turns": "2"
    },
    "requests": [
      {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "How did the run go?"
                },
                {
                  "type": "image_url",
                  "image_url": {
                    "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==",
                    "detail": "$absent"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "How did the run go?"
                },
                {
                  "type": "image_url",
                  "image_url": {
                    "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg==",
                    "detail": "$absent"
                  }
                }
              ]
            },
            {
              "role": "assistant"
            },
            {
              "role": "tool"
            }
          ]
        }
      }
    ],
    "stdout": [
      "{\"trace\":\"ai-agent\",\"event\":\"turn\",\"turn\":1",
      "{\"trace\":\"ai-agent\",\"event\":\"tool\",\"turn\":1,\"tool\":\"clock\",\"server\":\"tools\""
    ]
  }
}
