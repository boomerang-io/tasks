{
  "description": "a credential field inside mcpServers is INVALID_PARAM, since Flow filters secrets by param type only",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "mcpServers": "[{\"name\": \"tools\", \"url\": \"http://127.0.0.1:9/mcp\", \"token\": \"leaky\"}]"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "x"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": "nonzero",
    "requestCount": 0,
    "stderr": [
      "INVALID_PARAM - mcpServers[0] may carry only name and url, not token; a credential goes in mcpTokens"
    ],
    "stderrNot": [
      "leaky"
    ]
  }
}
