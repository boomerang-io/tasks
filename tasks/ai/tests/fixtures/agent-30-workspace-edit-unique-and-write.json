{
  "description": "edit is refused unless old occurs exactly once; write creates parent directories",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "Bump the version and check it.",
    "workspaceTools": "edit,write",
    "workdir": "${WORKSPACE}/repo"
  },
  "workspace": {
    "repo/a.txt": "a a"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1_0",
                  "type": "function",
                  "function": {
                    "name": "edit",
                    "arguments": "{\"path\": \"a.txt\", \"old\": \"a\", \"new\": \"b\"}"
                  }
                },
                {
                  "id": "call_1_1",
                  "type": "function",
                  "function": {
                    "name": "write",
                    "arguments": "{\"path\": \"src/new/file.txt\", \"content\": \"hello\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-9",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "done"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "workspace": {
      "repo/a.txt": "a a",
      "repo/src/new/file.txt": "hello"
    },
    "requests": [
      {
        "index": 1,
        "bodyContains": [
          "ERROR: old occurs 2 times in a.txt; it must occur exactly once",
          "wrote 5 bytes to src/new/file.txt"
        ]
      }
    ]
  }
}
