{
  "description": "happy path on a directory RESULTS_PATH (Tekton): one file per result, nine results, a minimal request body",
  "command": "prompt",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "resultKeys": [
      "output",
      "finishReason",
      "model",
      "promptTokens",
      "completionTokens",
      "totalTokens",
      "reasoningTokens",
      "cachedPromptTokens",
      "cost"
    ],
    "results": {
      "output": "The run succeeded in 12 seconds.",
      "promptTokens": "41",
      "completionTokens": "9",
      "totalTokens": "50",
      "finishReason": "stop",
      "model": "gpt-4o-mini-2024-07-18",
      "reasoningTokens": "",
      "cachedPromptTokens": "",
      "cost": ""
    },
    "requestCount": 1,
    "requests": [
      {
        "path": "/v1/chat/completions",
        "authorization": "Bearer sk-test-do-not-log-me",
        "contentType": "$contains:application/json",
        "body": {
          "model": "gpt-4o-mini",
          "messages": [
            {
              "role": "user",
              "content": "How did the run go?"
            }
          ],
          "temperature": "$absent",
          "max_tokens": "$absent",
          "max_completion_tokens": "$absent",
          "seed": "$absent",
          "response_format": "$absent",
          "tools": "$absent",
          "parallel_tool_calls": "$absent"
        }
      }
    ],
    "stdoutNot": [
      "sk-test-do-not-log-me"
    ],
    "stderrNot": [
      "sk-test-do-not-log-me"
    ]
  }
}
