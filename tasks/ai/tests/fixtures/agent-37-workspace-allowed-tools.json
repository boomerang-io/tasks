{
  "description": "allowedTools narrows the workspace tools as it does the MCP ones",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "Bump the version and check it.",
    "workspaceTools": "read,edit,bash",
    "workdir": "${WORKSPACE}/repo",
    "allowedTools": "[\"read\"]"
  },
  "workspace": {
    "repo/a.txt": "a"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-9",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "done"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "requests": [
      {
        "body": {
          "tools": [
            {
              "function": {
                "name": "read"
              }
            }
          ]
        }
      }
    ]
  }
}
