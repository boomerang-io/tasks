{
  "description": "an OTLP endpoint that refuses connections leaves results and the exit code unchanged and adds one warning",
  "command": "prompt",
  "otlpDead": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP_DEAD}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "00-00000000aaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01",
    "OTEL_SERVICE_NAME": "flow-task-ai-prompt",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "resultKeys": [
      "output",
      "finishReason",
      "model",
      "promptTokens",
      "completionTokens",
      "totalTokens",
      "reasoningTokens",
      "cachedPromptTokens",
      "cost"
    ],
    "results": {
      "output": "The run succeeded in 12 seconds."
    },
    "stdout": [
      "OpenTelemetry: ",
      "the task is unaffected"
    ]
  }
}
