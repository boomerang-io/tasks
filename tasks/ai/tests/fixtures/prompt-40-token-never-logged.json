{
  "description": "the token appears nowhere in stdout or stderr, including task-core's param log lines",
  "command": "prompt",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "stdout": [
      "Retrieving param: token"
    ],
    "stdoutNot": [
      "sk-test-do-not-log-me",
      "value: sk-"
    ],
    "stderrNot": [
      "sk-test-do-not-log-me"
    ]
  }
}
