{
  "description": "with content capture opted in, messages and the reply go on the span, but image data and URL query strings never do",
  "command": "prompt",
  "otlp": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "00-00000000aaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01",
    "OTEL_SERVICE_NAME": "flow-task-ai-prompt",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask",
    "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "true"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "images": "${WORKSPACE}/shot.png,https://img.example.com/b.png?X-Amz-Signature=sig-secret-123"
  },
  "workspace": {
    "shot.png": {
      "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGP4z8DwHwAFAAH/iZk9HQAAAABJRU5ErkJggg=="
    }
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "spanCount": 1,
    "spans": [
      {
        "name": "chat gpt-4o-mini",
        "attributes": {
          "gen_ai.input.messages": "$contains:https://img.example.com/b.png",
          "gen_ai.prompt": "$contains:[image data omitted]",
          "gen_ai.output.messages": "$contains:The run succeeded in 12 seconds.",
          "gen_ai.completion": "$contains:The run succeeded in 12 seconds."
        }
      }
    ],
    "spansNotContaining": [
      "iVBORw0KGgoAAAANSUhEUgAA",
      "sig-secret-123",
      "sk-test-do-not-log-me"
    ]
  }
}
