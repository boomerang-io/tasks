{
  "description": "files are appended as fenced blocks under their path and truncated at maxContextBytes with the omission named",
  "command": "prompt",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "files": "${WORKSPACE}/a.txt, ${WORKSPACE}/b.txt",
    "maxContextBytes": "100"
  },
  "workspace": {
    "a.txt": "alpha contents\n",
    "b.txt": ""
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "requests": [
      {
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "$contains:How did the run go?"
            }
          ]
        }
      },
      {
        "index": 0,
        "body": {
          "messages": [
            {
              "content": "$contains:## ${WORKSPACE}/a.txt"
            }
          ]
        }
      },
      {
        "index": 0,
        "body": {
          "messages": [
            {
              "content": "$contains:alpha contents"
            }
          ]
        }
      },
      {
        "index": 0,
        "body": {
          "messages": [
            {
              "content": "$contains:These files were omitted: ${WORKSPACE}/b.txt"
            }
          ]
        }
      }
    ],
    "stdout": [
      "file context truncated at 100 bytes"
    ]
  }
}
