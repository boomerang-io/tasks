{
  "description": "ai-agent with content capture: tool arguments and results go on execute_tool, messages on each chat span",
  "command": "agent",
  "otlp": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "00-00000000aaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01",
    "OTEL_SERVICE_NAME": "flow-task-ai-prompt",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask",
    "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "true"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "mcpServers": "[{\"name\": \"tools\", \"url\": \"${MCP:tools}\"}]"
  },
  "mcp": {
    "tools": {
      "tools": [
        {
          "name": "weather",
          "description": "Current weather for a city",
          "inputSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          },
          "result": "Sunny, 24C"
        },
        {
          "name": "clock",
          "description": "The current time",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "result": "12:00"
        }
      ]
    }
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "weather",
                    "arguments": "{\"city\": \"Sydney\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "Sunny"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 20,
          "completion_tokens": 6,
          "total_tokens": 26
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "spans": [
      {
        "name": "chat gpt-4o-mini",
        "attributes": {
          "gen_ai.input.messages": "$contains:How did the run go?",
          "gen_ai.output.messages": "$contains:call_1"
        }
      },
      {
        "name": "execute_tool weather",
        "attributes": {
          "gen_ai.tool.call.arguments": "{\"city\": \"Sydney\"}",
          "gen_ai.tool.call.result": "Sunny, 24C"
        }
      },
      {
        "name": "chat gpt-4o-mini",
        "attributes": {
          "gen_ai.input.messages": "$contains:Sunny, 24C",
          "gen_ai.output.messages": "$contains:Sunny"
        }
      }
    ],
    "spansNotContaining": [
      "sk-test-do-not-log-me"
    ]
  }
}
