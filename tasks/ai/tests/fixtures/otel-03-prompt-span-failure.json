{
  "description": "a rejected request marks the chat span as an error with the failure reason; the exit code is the same as without telemetry",
  "command": "prompt",
  "otlp": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "00-00000000aaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01",
    "OTEL_SERVICE_NAME": "flow-task-ai-prompt",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?"
  },
  "provider": [
    {
      "status": 401,
      "body": {
        "error": {
          "message": "Incorrect API key provided"
        }
      }
    }
  ],
  "expect": {
    "exit": "nonzero",
    "stderr": [
      "REQUEST_REJECTED"
    ],
    "spanCount": 1,
    "spans": [
      {
        "name": "chat gpt-4o-mini",
        "status": "error",
        "statusMessage": "$contains:HTTP 401",
        "attributes": {
          "error.type": "REQUEST_REJECTED"
        }
      }
    ]
  }
}
