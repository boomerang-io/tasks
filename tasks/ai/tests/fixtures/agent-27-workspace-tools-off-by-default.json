{
  "description": "with workspaceTools blank no workspace tool is offered, and the model calling bash fails UNKNOWN_TOOL",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "Bump the version and check it."
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1_0",
                  "type": "function",
                  "function": {
                    "name": "bash",
                    "arguments": "{\"command\": \"echo hi\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ],
  "expect": {
    "exit": "nonzero",
    "stderr": [
      "UNKNOWN_TOOL"
    ],
    "requestCount": 1,
    "stdout": [
      "\"event\":\"start\",\"workspaceTools\":[]"
    ],
    "requests": [
      {
        "body": {
          "tools": "$absent"
        }
      }
    ]
  }
}
