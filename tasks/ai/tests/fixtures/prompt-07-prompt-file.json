{
  "description": "promptFile reads the user message from the run workspace",
  "command": "prompt",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "promptFile": "${WORKSPACE}/big-prompt.md",
    "systemPrompt": "Sys"
  },
  "workspace": {
    "big-prompt.md": "A very long prompt\nover two lines\n"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "requests": [
      {
        "body": {
          "messages": [
            {
              "role": "system",
              "content": "Sys"
            },
            {
              "role": "user",
              "content": "A very long prompt\nover two lines\n"
            }
          ]
        }
      }
    ]
  }
}
