{
  "description": "the whole loop is bounded by timeoutSeconds: a running command is cut at the deadline and the run fails TIMEOUT_EXCEEDED",
  "command": "agent",
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "Bump the version and check it.",
    "workspaceTools": "bash",
    "workdir": "${WORKSPACE}/repo",
    "timeoutSeconds": "1"
  },
  "workspace": {
    "repo/a.txt": "a"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1_0",
                  "type": "function",
                  "function": {
                    "name": "bash",
                    "arguments": "{\"command\": \"sleep 5\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-9",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "done"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ],
  "expect": {
    "exit": "nonzero",
    "stderr": [
      "TIMEOUT_EXCEEDED",
      "timeoutSeconds=1"
    ],
    "requestCount": 1
  }
}
