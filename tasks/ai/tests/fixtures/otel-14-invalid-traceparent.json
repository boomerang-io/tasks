{
  "description": "a TRACEPARENT that is not valid W3C starts a new trace with a warning; the task is unaffected",
  "command": "prompt",
  "otlp": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "not-a-traceparent",
    "OTEL_SERVICE_NAME": "flow-task-ai-prompt",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?"
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "The run succeeded in 12 seconds."
            }
          }
        ],
        "usage": {
          "prompt_tokens": 41,
          "completion_tokens": 9,
          "total_tokens": 50
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "stdout": [
      "TRACEPARENT is not a valid W3C traceparent; spans start a new trace"
    ],
    "spanCount": 1,
    "spans": [
      {
        "name": "chat gpt-4o-mini",
        "parent": "$root",
        "parentSpanId": ""
      }
    ]
  }
}
