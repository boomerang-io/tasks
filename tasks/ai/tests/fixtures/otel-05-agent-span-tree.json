{
  "description": "ai-agent: invoke_agent under TRACEPARENT holds MCP initialize and tools/list, a chat span per turn and execute_tool per call with tools/call beneath it",
  "command": "agent",
  "otlp": true,
  "env": {
    "OTEL_EXPORTER_OTLP_ENDPOINT": "${OTLP}",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "TRACEPARENT": "00-00000000aaaaaaaaaaaaaaaaaaaaaaaa-bbbbbbbbbbbbbbbb-01",
    "OTEL_SERVICE_NAME": "flow-task-ai-agent",
    "OTEL_RESOURCE_ATTRIBUTES": "flow.workflow.run.id=aaaaaaaaaaaaaaaaaaaaaaaa,flow.task.run.id=ccccccccccccccccbbbbbbbbbbbbbbbb,flow.task.name=ask"
  },
  "params": {
    "endpoint": "${PROVIDER}",
    "token": "sk-test-do-not-log-me",
    "model": "gpt-4o-mini",
    "prompt": "How did the run go?",
    "mcpServers": "[{\"name\": \"tools\", \"url\": \"${MCP:tools}\"}]"
  },
  "mcp": {
    "tools": {
      "tools": [
        {
          "name": "weather",
          "description": "Current weather for a city",
          "inputSchema": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          },
          "result": "Sunny, 24C"
        },
        {
          "name": "clock",
          "description": "The current time",
          "inputSchema": {
            "type": "object",
            "properties": {}
          },
          "result": "12:00"
        }
      ]
    }
  },
  "provider": [
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_1",
                  "type": "function",
                  "function": {
                    "name": "weather",
                    "arguments": "{\"city\": \"Sydney\"}"
                  }
                }
              ]
            }
          }
        ],
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": {
              "role": "assistant",
              "content": "Sunny"
            }
          }
        ],
        "usage": {
          "prompt_tokens": 20,
          "completion_tokens": 6,
          "total_tokens": 26
        }
      }
    }
  ],
  "expect": {
    "exit": 0,
    "results": {
      "output": "Sunny",
      "turns": "2",
      "toolCalls": "1",
      "totalTokens": "41"
    },
    "spanCount": 7,
    "stdout": [
      "{\"trace\":\"ai-agent\",\"event\":\"turn\",\"turn\":1",
      "{\"trace\":\"ai-agent\",\"event\":\"tool\",\"turn\":1,\"tool\":\"weather\""
    ],
    "spans": [
      {
        "name": "invoke_agent ai-agent",
        "parent": "$root",
        "traceId": "00000000aaaaaaaaaaaaaaaaaaaaaaaa",
        "parentSpanId": "bbbbbbbbbbbbbbbb",
        "kind": "internal",
        "status": "unset",
        "attributes": {
          "gen_ai.operation.name": "invoke_agent",
          "gen_ai.agent.name": "ai-agent",
          "gen_ai.request.model": "gpt-4o-mini",
          "flow.agent.turns": 2,
          "flow.agent.tool_calls": 1
        }
      },
      {
        "name": "initialize",
        "parent": "invoke_agent ai-agent",
        "traceId": "00000000aaaaaaaaaaaaaaaaaaaaaaaa",
        "kind": "client",
        "attributes": {
          "mcp.method.name": "initialize",
          "flow.mcp.server.name": "tools",
          "server.address": "127.0.0.1"
        }
      },
      {
        "name": "tools/list",
        "parent": "invoke_agent ai-agent",
        "attributes": {
          "mcp.method.name": "tools/list",
          "flow.mcp.tool.count": 2
        }
      },
      {
        "name": "chat gpt-4o-mini",
        "parent": "invoke_agent ai-agent",
        "kind": "client",
        "attributes": {
          "flow.agent.turn": 1,
          "gen_ai.usage.input_tokens": 10,
          "gen_ai.response.finish_reasons": [
            "tool_calls"
          ]
        }
      },
      {
        "name": "execute_tool weather",
        "parent": "invoke_agent ai-agent",
        "kind": "internal",
        "status": "unset",
        "attributes": {
          "gen_ai.operation.name": "execute_tool",
          "gen_ai.tool.name": "weather",
          "gen_ai.tool.call.id": "call_1",
          "flow.agent.turn": 1,
          "gen_ai.tool.call.arguments": "$absent",
          "gen_ai.tool.call.result": "$absent"
        }
      },
      {
        "name": "tools/call weather",
        "parent": "execute_tool weather",
        "kind": "client",
        "attributes": {
          "mcp.method.name": "tools/call",
          "gen_ai.tool.name": "weather",
          "flow.mcp.server.name": "tools"
        }
      },
      {
        "name": "chat gpt-4o-mini",
        "parent": "invoke_agent ai-agent",
        "attributes": {
          "flow.agent.turn": 2,
          "gen_ai.usage.input_tokens": 20,
          "gen_ai.response.finish_reasons": [
            "stop"
          ],
          "gen_ai.input.messages": "$absent",
          "gen_ai.prompt": "$absent",
          "gen_ai.output.messages": "$absent",
          "gen_ai.completion": "$absent"
        }
      }
    ],
    "spansNotContaining": [
      "Sydney",
      "Sunny, 24C",
      "How did the run go?",
      "sk-test-do-not-log-me"
    ]
  }
}
